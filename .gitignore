# ========================================================
# LCR OdontoGest - .gitignore
# Garante seguranca de dados dos pacientes e conformidade LGPD
# ========================================================

# Banco de dados e dados confidenciais de saude (NUNCA subir para nuvem publica)
data/*.db
data/*.sqlite
data/*.sqlite3
data/backups/
data/anexos/
backups/
uploads/

# Ambiente virtual Python
.venv/
venv/
env/
ENV/

# Caches do Python
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Compilacao e distribuicao executavel (.exe)
build/
dist/
*.spec

# IDEs e editores
.idea/
.vscode/
*.swp
*.swo

# Logs locais
*.log

# Segredos e Tokens de Autenticação (NUNCA versionar)
.github_token
github_token.txt
.env
*.token

# Atalhos Windows
*.lnk

# Arquivos temporários e capturas de teste
.tmp.driveupload/
tests/screenshots/
